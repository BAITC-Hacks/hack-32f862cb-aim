# Prefer: python3 scripts/configure.py
POSTGRES_PASSWORD=replace-with-generated-admin-password
OPTISTOCK_DB_PASSWORD=replace-with-generated-app-password
OPTISTOCK_DATABASE_URL=postgresql+psycopg://optistock:replace-with-generated-app-password@localhost:5435/optistock
OPTISTOCK_TEST_DATABASE_URL=postgresql+psycopg://optistock:replace-with-generated-app-password@localhost:5435/optistock_test
OPTISTOCK_STORAGE_ROOT=var/files
OPTISTOCK_SAMPLE_ROOT=.
OPTISTOCK_CORS_ORIGINS=["http://localhost:5173"]
OPTISTOCK_OPENAI_API_KEY=
OPTISTOCK_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPTISTOCK_AI_REQUESTS_PER_HOUR=30
OPTISTOCK_AI_MAX_STEPS=6
OPTISTOCK_AI_MAX_TOOL_CALLS=12
OPTISTOCK_AI_TOTAL_SECONDS=180
OPTISTOCK_AI_TOKEN_BUDGET=120000
